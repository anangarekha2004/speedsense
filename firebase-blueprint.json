{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Core identity data for grid operators.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["email", "role"]
    },
    "Expense": {
      "title": "Expense Log",
      "description": "A single transaction log in the grid.",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["Food", "Transport", "Bills", "Shopping", "Others"] },
        "date": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["amount", "category", "date", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Expense transaction logs."
    }
  }
}
